#!/bin/sh
set -e

chmod 755 /usr/local/bin/lunor-first-login || true
chmod 755 /etc/skel/Desktop/install-lunor.desktop || true

mkdir -p /etc/sudoers.d
printf '%s\n' 'lunor ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/99-lunor-live
chmod 440 /etc/sudoers.d/99-lunor-live

PLYMOUTH_DIR=/usr/share/plymouth/themes/lunor
if [ -d "$PLYMOUTH_DIR" ] && command -v rsvg-convert >/dev/null 2>&1; then
  rsvg-convert "$PLYMOUTH_DIR/background.svg" -o "$PLYMOUTH_DIR/background.png"
  rsvg-convert "$PLYMOUTH_DIR/logo.svg" -o "$PLYMOUTH_DIR/logo.png"
  rsvg-convert "$PLYMOUTH_DIR/wordmark.svg" -o "$PLYMOUTH_DIR/wordmark.png"
  rsvg-convert "$PLYMOUTH_DIR/loader.svg" -o "$PLYMOUTH_DIR/loader.png"
fi

if [ -f "$PLYMOUTH_DIR/lunor.plymouth" ]; then
  plymouth-set-default-theme lunor || true
  update-initramfs -u -k all || true
fi

SDDM_DIR=/usr/share/sddm/themes/lunor
if [ -d "$SDDM_DIR" ] && command -v rsvg-convert >/dev/null 2>&1; then
  rsvg-convert "$SDDM_DIR/background.svg" -o "$SDDM_DIR/background.png"
  rsvg-convert "$SDDM_DIR/logo.svg" -o "$SDDM_DIR/logo.png"
  cp "$SDDM_DIR/background.png" "$SDDM_DIR/preview.png"
fi

if [ -f /etc/sddm.conf.d/20-lunor-theme.conf ]; then
  chmod 644 /etc/sddm.conf.d/20-lunor-theme.conf
fi

WALLPAPER_DIR=/usr/share/wallpapers/LUNOR
if [ -d "$WALLPAPER_DIR" ] && command -v rsvg-convert >/dev/null 2>&1; then
  for name in lunor-wallpaper lunor-horizon lunor-silence lockscreen lock-avatar; do
    if [ -f "$WALLPAPER_DIR/$name.svg" ]; then
      rsvg-convert "$WALLPAPER_DIR/$name.svg" -o "$WALLPAPER_DIR/$name.png"
    fi
  done

  if [ -f "$WALLPAPER_DIR/lock-avatar.png" ]; then
    mkdir -p /usr/share/pixmaps
    cp "$WALLPAPER_DIR/lock-avatar.png" /usr/share/pixmaps/lunor-avatar.png
    cp "$WALLPAPER_DIR/lock-avatar.png" /etc/skel/.face.icon
  fi
fi

chmod 644 /etc/xdg/kscreenlockerrc 2>/dev/null || true
chmod 644 /etc/skel/.config/kscreenlockerrc 2>/dev/null || true
chmod 644 /etc/skel/.face.icon 2>/dev/null || true

chmod 644 /usr/share/color-schemes/Lunor.colors 2>/dev/null || true
chmod 644 /etc/skel/.config/kdeglobals 2>/dev/null || true

LUNOR_ICON=/usr/share/icons/hicolor/scalable/apps/lunor.svg
if [ -f "$LUNOR_ICON" ]; then
  mkdir -p /usr/share/pixmaps
  cp "$LUNOR_ICON" /usr/share/pixmaps/lunor.svg
  cp "$LUNOR_ICON" /usr/share/icons/hicolor/scalable/apps/distributor-logo.svg

  if command -v rsvg-convert >/dev/null 2>&1; then
    rsvg-convert -w 256 -h 256 "$LUNOR_ICON" -o /usr/share/pixmaps/lunor.png
  fi

  if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor >/dev/null 2>&1 || true
  fi
fi

chmod 644 /etc/os-release /etc/lsb-release /etc/lunor-release /etc/issue 2>/dev/null || true
