# LUNOR OS 1.1 — Plymouth boot theme
# Clean, calm, premium: midnight/navy background + soft aurora logo.

Window.SetBackgroundTopColor(0.008, 0.020, 0.040);
Window.SetBackgroundBottomColor(0.004, 0.010, 0.020);

bg.image = Image("background.png");
bg.image = bg.image.Scale(Window.GetWidth(), Window.GetHeight());
bg.sprite = Sprite(bg.image);
bg.sprite.SetX(0);
bg.sprite.SetY(0);
bg.sprite.SetZ(-100);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 44);
logo.sprite.SetZ(10);

wordmark.image = Image("wordmark.png");
wordmark.sprite = Sprite(wordmark.image);
wordmark.sprite.SetX(Window.GetWidth() / 2 - wordmark.image.GetWidth() / 2);
wordmark.sprite.SetY(Window.GetHeight() / 2 + 118);
wordmark.sprite.SetZ(10);

loader.image = Image("loader.png");
loader.sprite = Sprite(loader.image);
loader.sprite.SetX(Window.GetWidth() / 2 - loader.image.GetWidth() / 2);
loader.sprite.SetY(Window.GetHeight() - 118);
loader.sprite.SetZ(10);

fun refresh_callback ()
{
    t = Plymouth.GetTime();

    # Quiet fade-in during the first second.
    fade = t / 1.10;
    if (fade > 1)
        fade = 1;

    # A restrained breathing glow, never fully disappearing.
    breath = 0.82 + 0.18 * ((Math.Sin(t * 2.0) + 1.0) / 2.0);
    dots = 0.36 + 0.52 * ((Math.Sin(t * 3.0) + 1.0) / 2.0);

    logo.sprite.SetOpacity(fade * breath);
    wordmark.sprite.SetOpacity(fade * 0.92);
    loader.sprite.SetOpacity(fade * dots);
}

Plymouth.SetRefreshFunction(refresh_callback);

fun message_callback (text)
{
    # Keep normal boot quiet. Only surface real system messages.
    if (status.sprite)
        status.sprite.Remove();

    status.image = Image.Text(text, 0.62, 0.75, 0.92, 0.90, "Sans 12");
    status.sprite = Sprite(status.image);
    status.sprite.SetX(Window.GetWidth() / 2 - status.image.GetWidth() / 2);
    status.sprite.SetY(Window.GetHeight() - 74);
    status.sprite.SetZ(20);
}

Plymouth.SetMessageFunction(message_callback);
