# LUNOR OS 1.1 — animated Plymouth boot
# Images are artwork only. All visible words are rendered as text.

Window.SetBackgroundTopColor(0.008, 0.020, 0.040);
Window.SetBackgroundBottomColor(0.004, 0.010, 0.020);

bg.image = Image("background.png");
bg.image = bg.image.Scale(Window.GetWidth(), Window.GetHeight());
bg.sprite = Sprite(bg.image);
bg.sprite.SetX(0);
bg.sprite.SetY(0);
bg.sprite.SetZ(-100);
bg.sprite.SetOpacity(0);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 54);
logo.sprite.SetZ(10);
logo.sprite.SetOpacity(0);

brand.image = Image.Text("LUNOR OS", 0.96, 0.98, 1.0, 0.96, "Sans 18");
brand.sprite = Sprite(brand.image);
brand.sprite.SetX(Window.GetWidth() / 2 - brand.image.GetWidth() / 2);
brand.sprite.SetY(Window.GetHeight() / 2 + 108);
brand.sprite.SetZ(12);
brand.sprite.SetOpacity(0);

status.exists = 0;

fun clamp01(v)
{
    if (v < 0)
        return 0;
    if (v > 1)
        return 1;
    return v;
}

fun refresh_callback ()
{
    t = Plymouth.GetTime();

    # 0.0–0.8s: background appears.
    bg_fade = clamp01(t / 0.8);
    bg.sprite.SetOpacity(bg_fade);

    # 0.8–1.6s: LUNOR mark appears and gently breathes.
    logo_fade = clamp01((t - 0.8) / 0.8);
    breath = 0.92 + 0.08 * ((Math.Sin(t * 2.0) + 1.0) / 2.0);
    logo.sprite.SetOpacity(logo_fade * breath);

    # 1.6–2.3s: brand text appears.
    brand_fade = clamp01((t - 1.6) / 0.7);
    brand.sprite.SetOpacity(brand_fade);

    # 2.3–3.0s: localized boot status supplied by systemd appears.
    if (status.exists)
    {
        status_fade = clamp01((t - 2.3) / 0.7);
        status.sprite.SetOpacity(status_fade);
    }
}

Plymouth.SetRefreshFunction(refresh_callback);

fun message_callback (text)
{
    if (status.exists)
        status.sprite.Remove();

    status.image = Image.Text(text, 0.62, 0.79, 1.0, 0.92, "Sans 12");
    status.sprite = Sprite(status.image);
    status.sprite.SetX(Window.GetWidth() / 2 - status.image.GetWidth() / 2);
    status.sprite.SetY(Window.GetHeight() / 2 + 148);
    status.sprite.SetZ(20);
    status.sprite.SetOpacity(0);
    status.exists = 1;
}

Plymouth.SetMessageFunction(message_callback);
