{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trainingbot-comms-telegram",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TELEGRAM_COMMS_STATE",
        "class_name": "TelegramCommsState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TelegramCommsState"]
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.2-1b-instruct",
    "MAX_AI_CALLS_PER_DAY": "40"
  }
}
